{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug action (src/main.ts)",
      "runtimeArgs": ["-r", "ts-node/register"],
      "program": "${workspaceFolder}/src/main.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        // core.getInput()/getBooleanInput() read INPUT_<NAME>, name uppercased with
        // spaces (not hyphens) turned into underscores — fill these in per run.
        "GITHUB_WORKSPACE": "${workspaceFolder}",
        "GITHUB_STEP_SUMMARY": "${workspaceFolder}/.debug/step-summary.md",
        "INPUT_SERVER-URL": "https://sftpgo.example.com",
        "INPUT_AUTHENTICATION-METHOD": "username-password",
        "INPUT_USERNAME": "admin",
        "INPUT_PASSWORD": "changeme",
        "INPUT_API-KEY": "",
        "INPUT_PROJECT-PATH": "sftpgo",
        "INPUT_RETAIN-EXTRA-ARTIFACTS": "true",
        "INPUT_SIMULATE": "true",
        "INPUT_WRITE-SUMMARY": "false"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
